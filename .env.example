# Apollo Environment Configuration
APOLLO_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# SEC EDGAR Requirements
# Format: SampleApp/1.0 (contact@example.com)
SEC_USER_AGENT=ApolloResearch/1.0 (research@example.com)
SEC_RATE_LIMIT_PER_SEC=5.0
SEC_TIMEOUT_SECONDS=15.0

# Bounded Autonomy Limits
MAX_FOLLOWUP_ROUNDS=3
MAX_RETRIEVAL_REQUESTS_PER_RUN=20

# Persistence: sqlite:///./apollo_research.db or postgresql://user:pass@localhost:5432/apollo
DATABASE_URL=sqlite:///./apollo_research.db

# LLM Model Provider
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# PDF Artifact Storage
REPORT_OUTPUT_DIR=./reports
